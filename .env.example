DATABASE_URL=postgres://encjson_admin:change_me@localhost:5432/encjson
ENCRYPTION_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars

ENCJSON_KEYS_ADDR=127.0.0.1:8080
ENCJSON_KEYS_AUTH=required

# Human, CLI and service-to-service issuer.
ENCJSON_KEYS_JWT_ISSUER=https://sso.cloud-app.cz
ENCJSON_KEYS_JWKS_URL=https://sso.cloud-app.cz/.well-known/jwks.json
ENCJSON_KEYS_JWT_AUDIENCE=encjson-keys-server

# Optional Kubernetes/OpenShift projected ServiceAccount JWT issuer.
# ENCJSON_KEYS_KUBE_SA_ISSUER=https://kubernetes.default.svc
# ENCJSON_KEYS_KUBE_SA_AUDIENCE=key-server
# ENCJSON_KEYS_KUBE_SA_DISCOVERY_URL=https://kubernetes.default.svc/.well-known/openid-configuration
# ENCJSON_KEYS_KUBE_SA_JWKS_URL=https://kubernetes.default.svc/openid/v1/jwks

# Optional local authorization policy for bearer/proxy principals.
# ENCJSON_KEYS_AUTHZ_FILE=/etc/encjson/bearer-authz.yaml

# Optional trusted proxy header mode. Enable only behind a proxy that strips
# client-supplied X-Auth-* headers and blocks direct public access.
# ENCJSON_KEYS_TRUSTED_PROXY_HEADERS=false
